{
  "name": "09-sole-incoming-candidate",
  "about": "The sole incoming candidate ref must survive failed preservation even with no workspace. Successful retry preserves it before deletion.",
  "steps": [
    {"do": ["Put", {"id": "r1", "status": "running", "alive": false, "onBase": false, "lastEvent": "other", "incoming": true, "queued": false, "claim": true, "reason": "", "work": false, "preserved": false, "preserveOk": false}]},
    {"do": ["Recover"], "expect": {"last": "ok", "line": "cleanup_failure", "claim": "", "runs": {"r1": {"status": "failed", "reason": "crashed", "work": false, "incoming": true, "preserved": false, "cleanupPending": true, "queued": false}}}},
    {"do": ["Reapprove", {"id": "r1"}], "expect": {"last": "cleanup_pending"}},
    {"do": ["PreservationResult", {"id": "r1", "ok": true}]},
    {"do": ["Recover"], "expect": {"last": "ok", "line": "crashed", "claim": "", "runs": {"r1": {"status": "failed", "reason": "crashed", "work": false, "incoming": false, "preserved": true, "cleanupPending": false, "queued": false}}}},
    {"do": ["Recover"], "expect": {"last": "ok", "line": "unchanged", "claim": "", "runs": {"r1": {"status": "failed", "reason": "crashed", "work": false, "incoming": false, "preserved": true, "cleanupPending": false, "queued": false}}}}
  ]
}
