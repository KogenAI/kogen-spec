{
  "name": "06-preservation-failure-and-retry",
  "about": "A kill before the first snapshot retains the only candidate on publication failure. Terminal cleanup retries; reapproval cannot discard retained work.",
  "steps": [
    {"do": ["Put", {"id": "r1", "status": "running", "alive": false, "onBase": false, "lastEvent": "other", "incoming": false, "queued": false, "claim": true, "reason": "", "work": true, "preserved": false, "preserveOk": false}]},
    {"do": ["Recover"], "expect": {"last": "ok", "line": "cleanup_failure", "claim": "", "runs": {"r1": {"status": "failed", "reason": "crashed", "work": true, "incoming": false, "preserved": false, "cleanupPending": true, "queued": false}}}},
    {"do": ["Recover"], "expect": {"last": "ok", "line": "cleanup_failure", "claim": "", "runs": {"r1": {"status": "failed", "reason": "crashed", "work": true, "incoming": false, "preserved": false, "cleanupPending": true, "queued": false}}}},
    {"do": ["Reapprove", {"id": "r1"}], "expect": {"last": "cleanup_pending", "runs": {"r1": {"status": "failed", "reason": "crashed", "work": true, "incoming": false, "preserved": false, "cleanupPending": true, "queued": false}}}},
    {"do": ["PreservationResult", {"id": "r1", "ok": true}]},
    {"do": ["Recover"], "expect": {"last": "ok", "line": "crashed", "claim": "", "runs": {"r1": {"status": "failed", "reason": "crashed", "work": false, "incoming": false, "preserved": true, "cleanupPending": false, "queued": false}}}},
    {"do": ["Recover"], "expect": {"last": "ok", "line": "unchanged", "claim": "", "runs": {"r1": {"status": "failed", "reason": "crashed", "work": false, "incoming": false, "preserved": true, "cleanupPending": false, "queued": false}}}},
    {"do": ["Reapprove", {"id": "r1"}], "expect": {"last": "ok", "line": "reapproved", "runs": {"r1": {"status": "approved", "queued": true, "preserved": true}}}}
  ]
}
